# notebook-to-webapp capture scratch (holds staged mzML/FASTA, executed notebooks)
.capture-baseline/

# eval run artifacts (screenshots, server logs) are regenerable; scores.jsonl is not
eval/tick-*/

# blind-judging key files: opening one before recording a verdict defeats the
# point, and committing them would make every past verdict re-derivable
eval/tick-*/.judge-*-key.json

# End-to-end build runs: disposable, one directory per tick
eval/builds/
eval/b/

# the eval harness is not part of the template
eval/

# the hook log is per-installation, not part of the framework
.claude/language-violations.jsonl
.claude/language-check-ran

# Electron shell: dependencies, the staged app payload and built installers
electron/node_modules/
electron/payload/
electron/dist/
!electron/build/
