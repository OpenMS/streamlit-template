{
  "name": "openms-streamlit-app",
  "productName": "OpenMS-StreamlitTemplateApp",
  "version": "1.0.0",
  "description": "Desktop shell for OpenMS Streamlit web apps",
  "author": "OpenMS Developer Team",
  "license": "BSD-3-Clause",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/unit.test.js",
    "dist": "electron-builder --win nsis --publish never",
    "dist:mac": "electron-builder --mac dmg --arm64 --publish never",
    "dist:linux": "electron-builder --linux AppImage --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.64.1"
  },
  "build": {
    "appId": "de.openms.streamlit-template",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "payload",
        "to": "app-payload"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "license": "../assets/openms_license.rtf"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.education",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Science",
      "synopsis": "OpenMS web app for mass spectrometry data",
      "maintainer": "OpenMS Developer Team <open-ms-general@lists.sourceforge.net>"
    },
    "publish": null
  },
  "homepage": "https://www.openms.de"
}
